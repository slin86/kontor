# Required: password of the Postgres user. Use a long random value.
KONTOR_DB_PASSWORD=change-me
# Set to false only when testing over plain HTTP, otherwise browsers drop the session cookie.
KONTOR_COOKIE_SECURE=true
# Decides which month counts as "now" (everything before it is locked history).
KONTOR_TIMEZONE=Europe/Berlin
# Host port of the web UI.
KONTOR_PORT=8080
