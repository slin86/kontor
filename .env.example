# Existing Postgres (create database and user first, see README). Use the driver prefix below.
# On the Docker host itself use host.docker.internal; otherwise the host name or IP of the server.
KONTOR_DATABASE_URL=postgresql+psycopg://kontor:change-me@host.docker.internal:5432/kontor
# Set to false only when testing over plain HTTP, otherwise browsers drop the session cookie.
KONTOR_COOKIE_SECURE=true
# The first household can always be created. Set to true to let anyone create further ones.
KONTOR_ALLOW_NEW_HOUSEHOLDS=false
# Decides which month counts as "now" (everything before it is locked history).
KONTOR_TIMEZONE=Europe/Berlin
# Host port of the web UI.
KONTOR_PORT=8080
